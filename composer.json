{
    "name": "gesior/ots-stats-analyzer",
    "description": "Import OTS Statistics logs into SQLite for analysis",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "symfony/console": "^6.4|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "OtsStats\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OtsStats\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/import.php"
    ]
}
